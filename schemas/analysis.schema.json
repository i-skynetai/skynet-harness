{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "[A-Za-z0-9][A-Za-z0-9_-]{0,127}"
    },
    "type": {
      "const": "analysis"
    },
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_revision": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "in_scope",
        "out_of_scope"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "statement",
          "citations"
        ]
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "proposed",
                    "accepted",
                    "superseded",
                    "rejected"
                  ]
                },
                "closes": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "status",
                "closes"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "closed_by": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "question",
          "candidates",
          "reason"
        ]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hits": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "characters": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "operations",
        "hits",
        "characters",
        "run"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relates_to": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sky_agent": {
      "type": "string",
      "x-written-by": "runtime"
    },
    "sky_run": {
      "type": "string",
      "x-written-by": "runtime"
    },
    "sky_role": {
      "type": "string",
      "x-written-by": "runtime"
    },
    "sky_task": {
      "type": "string",
      "x-written-by": "runtime"
    },
    "sky_kb": {
      "type": "string",
      "x-written-by": "runtime"
    }
  },
  "required": [
    "id",
    "type",
    "schema_version",
    "title",
    "project",
    "goal",
    "scope",
    "evidence_revision",
    "intent",
    "findings",
    "open_questions",
    "risks",
    "retrieval",
    "citations",
    "relates_to",
    "sky_agent",
    "sky_run",
    "sky_role",
    "sky_task",
    "sky_kb"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sky:schema:analysis",
  "title": "analysis"
}
